FROM python:3.13.13-slim-bookworm
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /workspace

COPY pyproject.toml uv.lock ./
COPY app/ ./app/

# Install the exact versions pinned in uv.lock, then the launchpad package
# itself (editable, no deps) into the system interpreter. A plain
# `uv pip install -e .` ignores uv.lock and pulls whatever is newest on PyPI.
# Editable install means code edits picked up by a volume mount take effect
# without a rebuild.
RUN uv export --frozen --no-dev --no-emit-project -o /tmp/requirements.txt \
    && uv pip install --system -r /tmp/requirements.txt \
    && uv pip install --system --no-deps -e . \
    && rm /tmp/requirements.txt

RUN chmod +x /workspace/app/launchpad/start.sh

EXPOSE 8080

CMD ["/workspace/app/launchpad/start.sh"]
