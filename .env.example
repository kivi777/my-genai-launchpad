# Application
PROJECT_NAME=launchpad

# Database
DATABASE_HOST=localhost
DATABASE_NAME=postgres
# Use postgres when only docker-compose.launchpad.yml is running.
# If docker-compose.supabase.yml is enabled, use postgres.<POOLER_TENANT_ID>
# from docker/.env.example instead, for example: postgres.launchpad
DATABASE_USER=postgres
DATABASE_PASSWORD=your-super-secret-and-long-postgres-password
DATABASE_PORT=5432

# TypeSafe (Jev)
TYPESAFE_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
OPENAI_API_VERSION=2024-07-01-preview

# Anthropic
ANTHROPIC_API_KEY=

# Google / Vertex AI
GOOGLE_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=/app/google-service-account.json
GOOGLE_VERTEX_AI_LOCATION=europe-west1

# Ollama
OLLAMA_BASE_URL=http://localhost:11434/v1

# AWS Bedrock
BEDROCK_AWS_ACCESS_KEY_ID=
BEDROCK_AWS_SECRET_ACCESS_KEY=
BEDROCK_AWS_REGION=

# Langfuse (observability)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
RESEARCH_LANGFUSE_ENABLED=0
# Optional: link to the trace during execution.
LANGFUSE_PROJECT_ID=

# Research workspace intent planning (DeepSeek)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
RESEARCH_INTENT_MODEL=deepseek-flash
RESEARCH_CHAT_MODEL=deepseek-flash
SILICONFLOW_API_KEY=

# Optional read-only research MCP tool
RESEARCH_EXTERNAL_MCP_URL=
RESEARCH_EXTERNAL_MCP_TOOL=

# Optional presentation MCP renderer
RESEARCH_PPT_MCP_URL=
# RESEARCH_PPT_OUTPUT_DIR=/tmp/launchpad-research-decks

# Persistent uploads (default: data/research-uploads in the backend repository)
# RESEARCH_UPLOAD_DIR=/absolute/path/to/research-uploads
# Compose host directory override belongs in docker/.env
# RESEARCH_UPLOAD_HOST_DIR=../data/research-uploads
